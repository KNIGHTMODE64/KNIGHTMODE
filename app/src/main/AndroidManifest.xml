<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required for the floating button, fake call, and vibration -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- NEW: Android 14 requires explicit foreground service types -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="GuardOfKnight"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Main App Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fake Call Screen -->
        <activity
            android:name=".feature.fakecall.FakeCallActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- NEW: Decoy Notes/Utility Screen for Panic Purge -->
        <activity
            android:name=".DecoyActivity"
            android:exported="false" />

        <!-- Floating Button Background Service -->
        <service
            android:name=".service.FloatingEdgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            
            <!-- Android 14 requires a property tag for specialUse -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating Edge Trigger" />
        </service>

    </application>
</manifest>
